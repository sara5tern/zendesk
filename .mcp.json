{
  "mcpServers": {
    "zendesk": {
      "command": "uv",
      "args": ["--directory", "${ZENDESK_MCP_DIR}", "run", "zendesk"],
      "env": {
        "ZENDESK_SUBDOMAIN": "${ZENDESK_SUBDOMAIN}",
        "ZENDESK_EMAIL": "${ZENDESK_EMAIL}",
        "ZENDESK_API_KEY": "${ZENDESK_API_KEY}"
      }
    }
  }
}
