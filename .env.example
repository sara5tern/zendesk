# Path to a local clone of a Zendesk MCP server (see README.md)
ZENDESK_MCP_DIR=/path/to/zendesk-mcp-server
# https://mycompany.zendesk.com -> mycompany
ZENDESK_SUBDOMAIN=
# Email of the account that created the API token
ZENDESK_EMAIL=
# Admin Center > Apps and integrations > APIs > Zendesk API > API tokens
ZENDESK_API_KEY=
